{
  "classifier": {
    "mode": "auto",
    "cacheHours": 1,
    "cacheMaxEntries": 2000,
    "llmClassifierModel": "deepseek-flash",

    "fusionConfidenceThreshold": 0.65,

    "fusionWeights": {
      "rule": 0.25,
      "embedding": 0.30,
      "profile": 0.15,
      "llm": 0.30
    },

    "embedding": {
      "minSimilarity": 0.25,
      "topK": 3
    },

    "profile": {
      "lowCharCount": 500,
      "highCharCount": 12000,
      "deepConversation": 8,
      "longSystemPrompt": 3000,
      "largeInputChars": 20000
    }
  },
  "router": {
    "costWeight": 0.3,
    "qualityWeight": 0.7,
    "fallbackModel": "deepseek-flash",
    "providerFallbackChain": ["deepseek-flash", "deepseek-v4-pro"],
    "defaultMode": "cheap"
  }
}
